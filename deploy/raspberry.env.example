# Avvio iniziale sicuro: anche sul Raspberry la prima installazione usa mock.
HARDWARE_MODE=mock
NETWORK_MODE=local
PORT=5000
TIMEZONE=Europe/Rome
DATA_DIR=data
# Dopo aver verificato cablaggio e relè a carico disconnesso:
# HARDWARE_MODE=real
# RELAY_PIN=17
# RELAY_ACTIVE_HIGH=false
# Sensori: gli stessi pin vanno configurati negli overlay di config.txt.
DS18B20_ENABLED=false
DS18B20_PIN=4
# DS18B20_ID=28-000000abcdef
DHT11_ENABLED=false
DHT11_PIN=22
# DHT11_DEVICE=iio:device0
# LAN: inserire anche l'IP o hostname del Raspberry negli ALLOWED_HOSTS.
# NETWORK_MODE=lan
# API_TOKEN=INSERIRE_UN_TOKEN_CASUALE_DI_ALMENO_32_CARATTERI
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1],greenhouse.local,192.168.1.50
